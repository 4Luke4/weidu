BACKUP ~backup~
AUTHOR ~WeiDU regression tests~

BEGIN ~Control statement correctness~

OUTER_SET action_forward = 0
GOTO action_forward_done
OUTER_SET action_forward = 99
::action_forward_done::
OUTER_SET action_forward += 1
ACTION_IF action_forward != 1 BEGIN
  FAIL ~forward action GOTO executed a skipped statement~
END

OUTER_SET action_backward = 0
::action_retry::
OUTER_SET action_backward += 1
ACTION_IF action_backward < 3 BEGIN
  GOTO action_retry
END
ACTION_IF action_backward != 3 BEGIN
  FAIL ~backward action GOTO did not resume at its label~
END

OUTER_SET action_loop_goto = 0
OUTER_WHILE action_loop_goto < 2 BEGIN
  OUTER_SET action_loop_goto += 1
  GOTO action_loop_goto_done
END
OUTER_SET action_loop_goto = 99
::action_loop_goto_done::
ACTION_IF action_loop_goto != 1 BEGIN
  FAIL ~action GOTO did not leave a nested loop~
END

OUTER_SET action_try = 0
ACTION_TRY
  GOTO action_try_done
WITH
  DEFAULT
    OUTER_SET action_try = 99
END
OUTER_SET action_try = 98
::action_try_done::
OUTER_SET action_try += 1
ACTION_IF action_try != 1 BEGIN
  FAIL ~ACTION_TRY caught or corrupted an action GOTO~
END

OUTER_SET scope_probe = 7
WITH_SCOPE BEGIN
  OUTER_SET scope_probe = 9
  GOTO action_scope_done
END
OUTER_SET scope_probe = 99
::action_scope_done::
ACTION_IF scope_probe != 7 BEGIN
  FAIL ~an action GOTO bypassed WITH_SCOPE cleanup~
END

OUTER_SET action_while_count = 0
OUTER_WHILE 1 BEGIN
  OUTER_SET action_while_count += 1
  BREAK
END
ACTION_IF action_while_count != 1 BEGIN
  FAIL ~BREAK did not exit OUTER_WHILE~
END

OUTER_SET action_for_count = 0
OUTER_FOR (action_for_index = 0; action_for_index < 10; ++action_for_index) BEGIN
  OUTER_SET action_for_count += 1
  ACTION_IF action_for_index = 2 BEGIN
    BREAK
  END
END
ACTION_IF action_for_count != 3 OR action_for_index != 2 BEGIN
  FAIL ~BREAK did not exit OUTER_FOR before its increment~
END

OUTER_SET action_outer_count = 0
OUTER_SET action_inner_count = 0
OUTER_FOR (outer_index = 0; outer_index < 3; ++outer_index) BEGIN
  OUTER_FOR (inner_index = 0; inner_index < 3; ++inner_index) BEGIN
    OUTER_SET action_inner_count += 1
    BREAK
  END
  OUTER_SET action_outer_count += 1
END
ACTION_IF action_outer_count != 3 OR action_inner_count != 3 BEGIN
  FAIL ~BREAK did not select the innermost action loop~
END

OUTER_SET action_each_count = 0
ACTION_FOR_EACH item IN ~alpha~ ~beta~ ~gamma~ BEGIN
  OUTER_SET action_each_count += 1
  ACTION_IF ~%item%~ STRING_EQUAL ~beta~ BEGIN
    BREAK
  END
END
ACTION_IF action_each_count != 2 BEGIN
  FAIL ~BREAK did not exit ACTION_FOR_EACH~
END

OUTER_SET $control_items(~alpha~) = 1
OUTER_SET $control_items(~beta~) = 2
OUTER_SET action_php_count = 0
ACTION_PHP_EACH control_items AS control_key => control_value BEGIN
  OUTER_SET action_php_count += 1
  BREAK
END
ACTION_IF action_php_count != 1 BEGIN
  FAIL ~BREAK did not exit ACTION_PHP_EACH~
END

OUTER_SET action_bash_count = 0
ACTION_BASH_FOR ~fixtures~ ~.*[.]txt$~ BEGIN
  OUTER_SET action_bash_count += 1
  BREAK
END
ACTION_IF action_bash_count != 1 BEGIN
  FAIL ~BREAK did not exit ACTION_BASH_FOR~
END

OUTER_PATCH_SAVE patch_buffer ~A~ BEGIN
  PATCH_IF 1 BEGIN
    INSERT_BYTES 1 1
    WRITE_ASCII 1 ~B~
    GOTO patch_buffer_done
  END
  WRITE_ASCII 0 ~X~
  ::patch_buffer_done::
END
ACTION_IF NOT (~%patch_buffer%~ STRING_EQUAL_CASE ~AB~) BEGIN
  FAIL ~patch GOTO lost buffer changes or executed a skipped statement~
END

OUTER_PATCH_SAVE unused_buffer ~~ BEGIN
  SET patch_backward = 0
  ::patch_retry::
  SET patch_backward += 1
  PATCH_IF patch_backward < 3 BEGIN
    GOTO patch_retry
  END

  SET patch_loop_goto = 0
  WHILE patch_loop_goto < 2 BEGIN
    SET patch_loop_goto += 1
    GOTO patch_loop_goto_done
  END
  SET patch_loop_goto = 99
  ::patch_loop_goto_done::

  SET patch_try = 0
  PATCH_TRY
    GOTO patch_try_done
  WITH
    DEFAULT
      SET patch_try = 99
  END
  SET patch_try = 98
  ::patch_try_done::
  SET patch_try += 1

  SET patch_scope_probe = 7
  PATCH_WITH_SCOPE BEGIN
    SET patch_scope_probe = 9
    GOTO patch_scope_done
  END
  SET patch_scope_probe = 99
  ::patch_scope_done::

  SET patch_while_count = 0
  WHILE 1 BEGIN
    SET patch_while_count += 1
    BREAK
  END

  SET patch_for_count = 0
  FOR (patch_for_index = 0; patch_for_index < 10; ++patch_for_index) BEGIN
    SET patch_for_count += 1
    PATCH_IF patch_for_index = 2 BEGIN
      BREAK
    END
  END

  SET patch_outer_count = 0
  SET patch_inner_count = 0
  FOR (patch_outer_index = 0; patch_outer_index < 3; ++patch_outer_index) BEGIN
    FOR (patch_inner_index = 0; patch_inner_index < 3; ++patch_inner_index) BEGIN
      SET patch_inner_count += 1
      BREAK
    END
    SET patch_outer_count += 1
  END

  SET patch_each_count = 0
  PATCH_FOR_EACH patch_item IN ~alpha~ ~beta~ ~gamma~ BEGIN
    SET patch_each_count += 1
    PATCH_IF ~%patch_item%~ STRING_EQUAL ~beta~ BEGIN
      BREAK
    END
  END

  SET patch_php_count = 0
  PATCH_PHP_EACH control_items AS patch_key => patch_value BEGIN
    SET patch_php_count += 1
    BREAK
  END

  SET patch_bash_count = 0
  PATCH_BASH_FOR ~fixtures~ ~.*[.]txt$~ BEGIN
    SET patch_bash_count += 1
    BREAK
  END
END

ACTION_IF patch_backward != 3 BEGIN
  FAIL ~backward patch GOTO did not resume at its label~
END
ACTION_IF patch_loop_goto != 1 BEGIN
  FAIL ~patch GOTO did not leave a nested loop~
END
ACTION_IF patch_try != 1 BEGIN
  FAIL ~PATCH_TRY caught or corrupted a patch GOTO~
END
ACTION_IF patch_scope_probe != 7 BEGIN
  FAIL ~a patch GOTO bypassed PATCH_WITH_SCOPE cleanup~
END
ACTION_IF patch_while_count != 1 BEGIN
  FAIL ~BREAK did not exit WHILE~
END
ACTION_IF patch_for_count != 3 OR patch_for_index != 2 BEGIN
  FAIL ~BREAK did not exit FOR before its increment~
END
ACTION_IF patch_outer_count != 3 OR patch_inner_count != 3 BEGIN
  FAIL ~BREAK did not select the innermost patch loop~
END
ACTION_IF patch_each_count != 2 BEGIN
  FAIL ~BREAK did not exit PATCH_FOR_EACH~
END
ACTION_IF patch_php_count != 1 BEGIN
  FAIL ~BREAK did not exit PATCH_PHP_EACH~
END
ACTION_IF patch_bash_count != 1 BEGIN
  FAIL ~BREAK did not exit PATCH_BASH_FOR~
END

PRINT ~control-statement tests passed~
